          "rate_bps": 0,
          "rate_percent": 0.0
        }
      ]
    },
    {
      "rule_id": "UNICARD_UP_DESIGNATED_BONUS",
      "layer": "bonus",
      "rate_bps": 350,
      "rate_percent": 3.5,
      "cap": {
        "points": 5000,
        "scope": "account_grouping",
        "scope_note": "歸戶：正卡+該正卡下所有附卡消費合併計算，回饋歸入正卡持卡人",
        "period": "calendar_month"
      },
      "conditions_all": [
        "plan_up_active",
        "transaction_matches_designated_spending",
        "transaction_is_bonus_eligible"
      ]
    }
  ],
  "headline_max_rate": {
    "rate_bps": 450,
    "rate_percent": 4.5,
    "formula": "eligible_base_reward + eligible_UP_bonus",
    "warning": "4.5% is not a single rule. Some transactions can qualify for the 3.5% UP bonus but not the 1% base reward."
  },
  "rounding": {
    "scope": "per_transaction_per_reward_layer",
    "method": "round_half_up_to_integer_point",
    "minimum_after_rounding": 1,
    "official_wording": "回饋計算採逐筆以實際刷卡請款金額乘以回饋率後計算四捨五入至整數回饋玉山e point，若四捨五入後未滿1點將不列入回饋。"
  },
